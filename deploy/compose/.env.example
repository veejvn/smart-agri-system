# Copy to deploy/compose/.env, set every value except IMAGE_TAG, then chmod 600.
# The CI deploy script supplies IMAGE_TAG; manual commands set it explicitly.
# Use URL-safe hex for Eureka credentials because
# the current Eureka clients embed them in the HTTP registry URL.
IMAGE_PREFIX=ghcr.io/veejvn/smart-agri-system
# Set IMAGE_TAG to a full 40-character commit SHA for validation/manual operations.
# The deployment workflow passes its commit SHA directly and does not trust latest.
IMAGE_TAG=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
USER_DB_USER=
USER_DB_PASSWORD=
EUREKA_USER=
EUREKA_PASSWORD=
# Generate from 32 random bytes, for example: openssl rand -base64 32
# This Base64 value is shared by Auth and Gateway and must not be changed independently.
APP_JWT_SECRET=
# Exact browser origin(s) allowed to call the Gateway, comma-separated if needed.
CORS_ALLOWED_ORIGINS=

# Optional host-level reverse proxy settings. Keep the bind address on loopback.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8080
