# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
MONGO_USER=admin
MONGO_PASSWORD=change_me
# 64 hex chars (32 bytes) shared by auth-service and api-gateway (must match)
JWT_SECRET=change_me_64_hex_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
# Credentials for the secured Eureka registry (discovery-service and all clients)
EUREKA_USER=eureka
EUREKA_PASSWORD=change_me
